<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <application android:theme="@style/AppTheme" android:label="Barcode Keyboard" android:allowBackup="false" android:supportsRtl="true">
        <service android:name=".BarcodeInputMethodService" android:label="Barcode Keyboard" android:permission="android.permission.BIND_INPUT_METHOD" android:exported="true">
            <intent-filter><action android:name="android.view.InputMethod" /></intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/method" />
        </service>
        <activity android:name=".ScannerActivity" android:label="Camera permission" android:theme="@style/PermissionGateTheme" android:exported="false" android:excludeFromRecents="true" />
        <activity android:name=".ProductImportActivity" android:label="匯入商品資料" android:exported="false" />
        <activity android:name=".UpdateActivity" android:label="線上更新" android:exported="false" />
    </application>
</manifest>
